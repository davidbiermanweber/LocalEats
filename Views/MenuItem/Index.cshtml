@model List<UserAuthApp.Models.MenuItem>

<div class="row">
    <div class="col-md-3">
        <h5>Categories</h5>
        <ul class="list-group">
            <li class="list-group-item">
                <a href="/MenuItem/Index">All</a>
            </li>
            @foreach (var category in ViewBag.Categories)
            {
                <li class="list-group-item">
                    <a href="/MenuItem/Index?category_id=@category.id">@category.name</a>
                </li>
            }
        </ul>
    </div>
    <div class="col-md-9">
        <h5>Menu Items</h5>
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <img src="@item.image_url" alt="@item.item_name" style="width:100%;" /><br />
                    <strong>@item.item_name</strong><br />
                    $@item.price<br />
                    @item.item_description<br />
                </div>
            }
        </div>
    </div>
</div>

