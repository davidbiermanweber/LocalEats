@model UserAuthApp.Models.MenuItem

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">Add a Menu Item</h2>
        <form method="post">
            <div class="mb-3">
                <label class="form-label">ItemName</label>
                <input asp-for="item_name" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">ItemDescription</label>
                <input asp-for="item_description" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Price</label>
                <input asp-for="price" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">ImageURL</label>
                <input asp-for="image_url" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">CategoryId</label>
                <input asp-for="category_id" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Add Menu Item</button>
        </form>
    </div>
</div>
