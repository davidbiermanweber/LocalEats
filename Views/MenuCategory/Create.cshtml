@model UserAuthApp.Models.MenuCategory

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">Add a Menu Category</h2>
        <form method="post">
            <div class="mb-3">
                <label class="form-label">CategoryName</label>
                <input asp-for="name" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">ItemDescription</label>
                <input asp-for="description" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Add Menu Category</button>
        </form>
    </div>
</div>
